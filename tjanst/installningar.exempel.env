# Inställningar för bokningstjänsten. Kopiera till installningar.env och fyll i.
# installningar.env checkas aldrig in, eftersom den kan innehålla lösenord.
# Värden med mellanslag skrivs inom citattecken.

# Datamappen med förfrågningarna. Lägg den utanför projektmappen, så att
# personuppgifterna inte följer med i en säkerhetskopia av projektet.
BOKNING_DATA=/home/pi/.local/share/kristvalla/pb_data

# Var tjänsten lyssnar. 127.0.0.1 betyder bara den egna datorn.
BOKNING_HTTP=127.0.0.1:8097
# Adressen i länkarna i mejlen, så som bokningsansvariga når tjänsten.
BOKNING_ADRESS=http://127.0.0.1:8097
# Hemsidans adress. Formuläret får då visas i en ruta ovanpå kalendern där.
# Lämna tomt om formuläret inte ska kunna visas inuti någon annan sida.
BOKNING_HEMSIDA=

# Bakom en tunnel (Pangolin): huvudet med besökarens egen adress. Lämna tomt
# om tjänsten inte ligger bakom en tunnel.
BOKNING_PROXYHUVUD=

# Vilka som får mejl om nya förfrågningar. Flera adresser skiljs med komma.
BOKNING_MOTTAGARE=bokningsansvarig@example.com,ersattare@example.com
# Avsändare för alla mejl, och vart hyresgästernas svar ska gå.
BOKNING_AVSANDARE=bokning@example.com
BOKNING_AVSANDARNAMN="Kristvalla Bygdegårdsförening"
BOKNING_SVARSADRESS=kristvalla@proton.me
# Läggs först i ämnesraden. Ta bort när tjänsten används på riktigt.
BOKNING_AMNESPREFIX="[PROV] "

# Påminnelse när ingen har svarat på så här många dagar. Kollas kl. 8 varje dag.
BOKNING_PAMINN_DAGAR=3
BOKNING_PAMINN_SCHEMA="0 8 * * *"

# Utgående e-post. Under provet: testbrevlådan epost_prov.py.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_ANVANDARE=
SMTP_LOSENORD=
SMTP_TLS=false
