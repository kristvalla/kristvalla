[Unit]
Description=Kristvalla – tunnel till Pangolin (Newt)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/kristvalla/newt.env
ExecStart=%h/Projects/kristvalla/tjanst/newt
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
